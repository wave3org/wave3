# Storage API URL - for IPFS uploads
# Local: http://localhost:3001
# Production: Set to your deployed storage API URL (e.g., https://wave3-storage.onrender.com)
NEXT_PUBLIC_STORAGE_API_URL=http://localhost:3001

# Ponder GraphQL API URL
# Local: http://localhost:42069
# Production: Set to your deployed Ponder service URL
NEXT_PUBLIC_PONDER_URL=http://localhost:42069

# IPFS Gateway for production
NEXT_PUBLIC_IPFS_GATEWAY_PROD=https://coral-accurate-peacock-411.mypinata.cloud/ipfs

# IPFS Gateway (optional, for file serving)
# Leave empty to use defaults (Pinata in production, localhost in dev)
# Include full URL with /ipfs path: https://coral-accurate-peacock-411.mypinata.cloud/ipfs
NEXT_PUBLIC_IPFS_GATEWAY=

# Alchemy API Key (optional, for production RPC)
NEXT_PUBLIC_ALCHEMY_API_KEY=

# WalletConnect Project ID (optional)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Build flags
NEXT_PUBLIC_IGNORE_BUILD_ERROR=false
